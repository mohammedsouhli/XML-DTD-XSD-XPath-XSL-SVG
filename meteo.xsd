<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- =================================================== -->
    <!-- Schéma XSD pour le document meteo                    -->
    <!-- =================================================== -->

    <!-- Élément racine : meteo -->
    <xs:element name="meteo">
        <xs:complexType>
            <xs:sequence>
                <!-- Une ou plusieurs mesures -->
                <xs:element name="mesure" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- Une ou plusieurs villes -->
                            <xs:element name="ville" maxOccurs="unbounded">
                                <xs:complexType>
                                    <!-- Attribut nom (chaîne de caractères) -->
                                    <xs:attribute name="nom" type="xs:string" use="required"/>
                                    <!-- Attribut temperature (entier) -->
                                    <xs:attribute name="temperature" type="xs:integer" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <!-- Attribut date (type date) -->
                        <xs:attribute name="date" type="xs:date" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
