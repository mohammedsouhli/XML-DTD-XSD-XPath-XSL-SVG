<!-- ========================================================== -->
<!-- DTD pour le document meteo                                  -->
<!-- Décrit la structure du document XML des mesures météo       -->
<!-- ========================================================== -->

<!-- L'élément racine "meteo" contient une ou plusieurs "mesure" -->
<!ELEMENT meteo (mesure+)>

<!-- Chaque "mesure" contient une ou plusieurs "ville" -->
<!ELEMENT mesure (ville+)>

<!-- L'élément "ville" est vide (uniquement des attributs) -->
<!ELEMENT ville EMPTY>

<!-- Attribut obligatoire "date" pour l'élément mesure -->
<!ATTLIST mesure
    date CDATA #REQUIRED
>

<!-- Attributs obligatoires "nom" et "temperature" pour l'élément ville -->
<!ATTLIST ville
    nom         CDATA #REQUIRED
    temperature CDATA #REQUIRED
>
